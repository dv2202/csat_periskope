# ---- Database (Supabase Postgres, or local Postgres via Docker) ----
# Supabase: use the "Connection string" (session pooler is fine for dev).
DATABASE_URL=postgresql://user:pass@localhost:5432/csat

# ---- Periskope ----
# Real: https://api.periskope.app/v1
# Mock (no WhatsApp number needed): http://localhost:4010 — switching is env-only.
PERISKOPE_BASE_URL=http://localhost:4010
PERISKOPE_API_KEY=mock-key
# Sending WhatsApp number: country code + number, no symbols (e.g. 919876512340)
PERISKOPE_PHONE=919000000000
# Signing Key from Periskope console: Settings > Webhooks.
# With the mock, any value works as long as app + mock share it.
PERISKOPE_SIGNING_SECRET=dev-signing-secret

# ---- Mock Periskope server (dev only) ----
MOCK_PORT=4010
# Where the mock fires webhooks. Defaults to APP_BASE_URL + /api/webhooks/periskope.
MOCK_WEBHOOK_TARGET=http://localhost:3000/api/webhooks/periskope

# ---- AI reply parser (used from M3) ----
# Provider is pluggable. Default: gemini (the key on hand).
LLM_PROVIDER=gemini
# Google Gemini
GEMINI_API_KEY=
# Fast + cheap model for classification / structured output
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative provider (set LLM_PROVIDER=anthropic to use):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Safety rails ----
# true = log what would be sent, send nothing. DEFAULT ON.
# With the mock server you can safely set DRY_RUN=false so sends actually hit the mock.
DRY_RUN=true
# Comma-separated contact numbers allowed to EVER receive a survey (dev safety).
# Empty + DRY_RUN=false in prod = anyone eligible. Set to your own test number first.
ALLOWLIST_NUMBERS=
# Dev only: skip HMAC check so the local simulator can post events. NEVER true in prod.
WEBHOOK_SKIP_SIGNATURE=false

# ---- URLs ----
APP_BASE_URL=http://localhost:3000
# Public URL your tunnel exposes, used by the setup script's printout.
PUBLIC_WEBHOOK_URL=
